# ─── CAPRO · TorqAI Technologies Inc. ──────────────────────────────────────
# Copy to `.env` and fill in. Never commit the real .env.

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/capro?schema=public"

# Public base URL of this deployment (used for Twilio + Stripe callbacks)
APP_BASE_URL="https://app.torqai.ca"

# ─── Better Auth ───────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="https://app.torqai.ca"

# OAuth social providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ─── Email (Resend) ────────────────────────────────────────────────────────
# Empty in dev → verification/reset codes print to the server console.
RESEND_API_KEY=""
EMAIL_FROM="CAPRO <no-reply@torqai.ca>"

# ─── Google Gemini (Google Gen AI SDK) ─────────────────────────────────────
# Gemini powers ALL intelligence + voice: TTS, live conversation, transcription,
# summaries, extraction. Twilio is transport only (numbers, SMS, media).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_LIVE_MODEL="gemini-2.5-flash-native-audio-latest"
# Absorb 429/503 spikes: each primary is retried on a second model before the
# request is failed. The TTS models are preview-tier and shed load regularly —
# a failure there is dead air on a live call, so the fallback matters.
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"
GEMINI_TTS_MODEL="gemini-3.1-flash-tts-preview"
GEMINI_TTS_FALLBACK_MODEL="gemini-2.5-flash-preview-tts"

# ─── Voice bridge (Twilio Media Streams ↔ Gemini Live) ─────────────────────
# Run separately:  node scripts/voice-bridge.mjs
VOICE_BRIDGE_PORT="3211"
VOICE_BRIDGE_SECRET=""  # random secret guarding the internal /api/voice/* routes
# Public wss URL Twilio Media Streams connects to (e.g. wss://<tunnel>/media).
# Empty → telephony falls back to the turn-based Gather + Gemini-TTS flow.
PUBLIC_WSS_URL=""

# ─── Twilio (Programmable Voice + SMS) — transport only ────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# E.164 number used to send outbound trigger SMS, e.g. +15145550123
TWILIO_SMS_FROM=""

# ─── Stripe (Subscriptions + metered overage) ──────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price IDs for each tier — auto-filled by: node scripts/stripe-setup.mjs
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PREMIUM=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_SCALE=""

# ConversationRelay (lowest-latency voice path): Twilio does STT/TTS at its
# edge and the bridge exchanges text with Gemini. Requires enabling the
# "Predictive and Generative AI/ML Features Addendum" in the Twilio Console.
USE_CONVERSATION_RELAY="false"
# Optional TTS overrides, e.g. provider "ElevenLabs" or "Google" + a voice id.
CONVERSATION_RELAY_TTS_PROVIDER=""
CONVERSATION_RELAY_VOICE=""
# Optional STT tuning for ConversationRelay (faster end-of-utterance detection):
CONVERSATION_RELAY_TRANSCRIPTION_PROVIDER=""
CONVERSATION_RELAY_SPEECH_MODEL=""

# Comma-separated emails exempt from trial expiry / subscription gating
# (internal test and demo accounts, e.g. the Silver Spoon test tenant).
TEST_ACCOUNT_EMAILS=""

# ─── Cron (Vercel scheduled jobs) ──────────────────────────────────────────
# Shared secret required by every /api/cron/* route. Without it the routes
# reject all callers — they send SMS, email and outbound calls.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""
# How often the crons actually run — must match the schedules in vercel.json.
# Reminders fire as soon as they would come due before the next run, so a
# wrong value here either skips reminders or sends them early. Vercel Hobby
# permits one run per day; lower this after upgrading to a tighter schedule.
CRON_CADENCE_HOURS="24"

# ─── Integration credential encryption ─────────────────────────────────────
# Wraps stored POS/CRM OAuth tokens at rest. Comma-separated versioned keys
# ("v1:<base64 32 bytes>,v2:..."), with the version used for new writes named
# by CREDENTIAL_ENC_ACTIVE. Retain old versions until /api/admin/integrations
# /rekey reports every row migrated. BACK THESE UP OFF-HOST: losing a key
# forces every tenant on it to reconnect their POS.
# Generate: node -e "console.log('v1:'+require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENC_KEYS=""
CREDENTIAL_ENC_ACTIVE="v1"

# ─── Square (POS integration) ──────────────────────────────────────────────
# Optional — without APP_ID/SECRET the Square card reports "not configured".
SQUARE_APP_ID=""
SQUARE_APP_SECRET=""
SQUARE_ENVIRONMENT="sandbox"   # "production" for live
# Required for webhooks; the endpoint fails closed without the signature key.
# SQUARE_WEBHOOK_URL must byte-for-byte match the notification URL registered
# in the Square dashboard — Square signs that URL plus the raw body, so any
# difference (scheme, trailing slash) rejects every delivery.
SQUARE_WEBHOOK_SIGNATURE_KEY=""
SQUARE_WEBHOOK_URL="https://<your-deployed-host>/api/integrations/square/webhook"
